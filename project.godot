[rendering]
; Linear, not nearest: the art is dense 1:1 pixel art, and nearest sampling at the
; fractional scales "expand" produces shimmers. At exactly 1536x1024 the two are
; identical, which is where the pixel-diff measures. art/ref/specs/11 §2.
textures/canvas_textures/default_texture_filter=1
; The letterbox bars beside the 3:2 frame on a wider display (window/stretch/
; aspect="keep" above) are painted with this colour and nothing else, so they
; are Palette.GROUND_PAGE — the colour behind everything — not the engine's grey.
; tests/unit/test_export.gd pins it.
environment/defaults/default_clear_color=Color(0.011764706, 0.043137256, 0.07450981, 1)
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
viewport/hdr_2d=true
